# Copy to .env and fill in. Note that .env is NOT loaded automatically —
# dotenv is not a dependency. Start the server with:
#   npm run dev            (or: node --env-file=.env dist/index.js after a build)

PORT=3000

# MongoDB connection string
db=

# Secret used to sign the app's own JWTs (src/services/authToken.ts, src/http/middlewares/authenticate.ts)
jwtPrivateKey=

# Stream Feeds v3 app credentials (@stream-io/node-sdk).
# These names are what the code reads — do not rename them to feedApiKey/feedSecretKey.
NEW_FEED_API_KEY=
NEW_CHAT_API_SECRET=

# Resend transactional email (src/services/mail.ts)
RESEND_API_KEY=
