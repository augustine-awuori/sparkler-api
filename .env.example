# Copy to .env and fill in. Note that .env is NOT loaded automatically —
# dotenv is not a dependency. Start the server with:
#   node --env-file=.env index.js

PORT=3000

# MongoDB connection string
db=

# Secret used to sign the app's own JWTs (models/sparkler.js)
jwtPrivateKey=

# Stream Feeds v3 app credentials (@stream-io/node-sdk).
# These names are what the code reads — do not rename them to feedApiKey/feedSecretKey.
NEW_FEED_API_KEY=
NEW_CHAT_API_SECRET=

# Stream Chat v2 app credentials (stream-chat, routes/chatToken.js)
chatApiKey=
chatApiSecret=

# Resend transactional email (services/mail.js)
RESEND_API_KEY=

# Poe-hosted "GraoAI" model, called through the OpenAI SDK (routes/grao.js)
POE_API_KEY=
