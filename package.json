{
  "name": "sparkler-api",
  "version": "1.0.0",
  "description": "Backend API for Sparkler, a campus social app.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:signup": "npm run build && node tests/signup.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@stream-io/node-sdk": "^0.7.28",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "expo-server-sdk": "^3.15.0",
    "express": "^5.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.3.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
